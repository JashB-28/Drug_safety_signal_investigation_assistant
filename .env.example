# Example configuration for the Drug Safety Signal Investigation Assistant.
# Copy to `.env` and adjust. Placeholders only — NEVER commit real secrets.
# This system uses only local/open resources; no API keys are required.

# Local Ollama server (default local install)
OLLAMA_HOST=http://localhost:11434

# Pinned local model tag (reproducibility requirement)
DSI_MODEL_TAG=mistral:7b-instruct

# openFDA base URL. An API key is OPTIONAL and only raises rate limits during
# development snapshotting; the eval/demo runs fully from the local cache and
# needs no key. Leave blank to use the keyless public endpoint.
OPENFDA_BASE_URL=https://api.fda.gov
OPENFDA_API_KEY=

# PubMed / NCBI E-utilities base (third evidence source, dev snapshotting only).
PUBMED_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils

# Paths (defaults are fine)
DSI_DB_PATH=data/db/dsi.sqlite
DSI_CACHE_DIR=data/cache
